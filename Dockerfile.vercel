# syntax=docker/dockerfile:1
# ไฟล์นี้ชื่อ Dockerfile.vercel ตามที่ Vercel Container ต้องการ
# build NestJS backend แล้วรันเป็น HTTP server ฟังที่ $PORT (Vercel ตั้งให้)

# ---------- base ----------
FROM node:22-alpine AS base
WORKDIR /app

# ---------- deps (ติดตั้งทั้งหมดเพื่อ build) ----------
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

# ---------- build (nest build -> dist) ----------
FROM deps AS build
COPY . .
RUN npm run build

# ---------- runner (prod เท่านั้น) ----------
FROM base AS runner
ENV NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force
COPY --from=build /app/dist ./dist
# main.ts อ่าน process.env.PORT (Vercel ตั้ง $PORT ให้) และ bind 0.0.0.0
CMD ["node", "dist/main.js"]
